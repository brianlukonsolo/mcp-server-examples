# Generate a token with: docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(24))"
# Docker Compose loads this file. See MANUAL.md for optional host execution.
MCP_AUTH_TOKEN=
# Exact public hostnames (optional :port), comma-separated; no schemes or wildcards.
MCP_ALLOWED_HOSTS=
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
# Optional Claude client credentials and setup are documented in MANUAL.md.
