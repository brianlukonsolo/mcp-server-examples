# Generate a token with: python -c "import secrets; print(secrets.token_hex(24))"
# Compose loads .env; bare Python does not. Export variables for direct execution.
MCP_AUTH_TOKEN=
# Exact public hostnames (optional :port), comma-separated; no schemes or wildcards.
MCP_ALLOWED_HOSTS=
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
# Optional Claude client only: set these in your shell, not just this file.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
